    "expo-file-system": "~58.0.15",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-local-authentication": "~58.0.3",
    "expo-router": "~58.0.33",
    "expo-screen-capture": "~58.0.6",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.24",
    "expo-splash-screen": "~58.0.15",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.1.0",
    "html2canvas-pro": "1.6.6",
    "lucide-react": "0.563.0",
