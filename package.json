{
  "name": "openalgo-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "prepare": "git config core.hooksPath .githooks || true",
    "lint": "biome ci .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:compat": "jest -c jest.compat.config.js --runInBand",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\" \"dev/**/*.test.mjs\"",
    "boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "export": "expo export --platform android --platform ios --output-dir dist-export",
    "bundles": "node scripts/check-bundles.mjs dist-export",
    "tokens": "node scripts/gen-tokens.mjs",
    "tokens:check": "node scripts/gen-tokens.mjs --check",
    "gen:frontend": "node scripts/gen-frontend.mjs",
    "gen:frontend:check": "node scripts/gen-frontend.mjs --check",
    "sync-openalgo": "node scripts/sync-openalgo.mjs",
    "mock": "node dev/mock-server/main.mjs",
    "record-fixtures": "node scripts/record-fixtures.mjs",
    "gen-golden": "node scripts/gen-golden.mjs",
    "real-server-check": "jest -c jest.real.config.js --runInBand",
    "preview:web": "bash dev/preview/preview.sh"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/react-query": "5.108.3",
    "axios": "1.20.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "expo": "~58.1.0",
    "expo-application": "~58.1.2",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.9",
